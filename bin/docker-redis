#!/bin/bash
set -e

# Test, build, tag and push the Redis (Valkey) cache image from the Drupal
#   performance recipe to ACR, as
#   acrcigie.azurecr.us/services/perf-redis:valkey-<version>-<revision>.
#   The image is deployed by its exact tag (Bicep redisImage), never 'latest'.

# Change to one directory above the script
cd "$(dirname "$0")/.." || exit

REVISION=$1
# Run from the recipe clone (infra/ next to bin/) or a site that still has the
# recipe folder; sites delete that folder after applying the recipe.
SCRIPT=""
for c in "infra/redis-image/push.sh" "recipes/drupal-performance-recipe/infra/redis-image/push.sh"; do
  if [ -f "$c" ]; then SCRIPT="$c"; break; fi
done

if [ -z "$SCRIPT" ]; then
  echo "infra/redis-image/push.sh not found. Run bin/docker-redis from the drupal-performance-recipe clone."
  exit 1
fi

if [ -z "$REVISION" ]; then
  read -p "Enter the image revision (1 for a new Valkey version, then 2, 3, ...): " REVISION
fi

bash "$SCRIPT" "$REVISION"
