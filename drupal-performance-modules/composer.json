{
    "name": "simplyshipley/drupal-performance-modules",
    "description": "Drupal modules for the performance recipe: perf_redis_failopen (a Redis outage becomes cache misses) and perf_purge_paths (cache tags become Azure Front Door purge paths), plus the settings include.",
    "type": "drupal-custom-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10.6 || ^11",
        "drupal/redis": "^1.11",
        "drupal/purge": "^3.7",
        "drupal/azure_cdn_purge": "^1.0"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^10.6 || ^11",
        "mglaman/phpstan-drupal": "^1.3 || ^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^1.2 || ^2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "qa": "bash scripts/qa.sh",
        "phpcs": "bash scripts/qa.sh phpcs",
        "phpstan": "bash scripts/qa.sh phpstan",
        "phpunit": "bash scripts/qa.sh phpunit"
    },
    "scripts-descriptions": {
        "qa": "Run phpcs, phpstan and phpunit against the Drupal site that contains this package (see README.md).",
        "phpcs": "Drupal and DrupalPractice coding standards.",
        "phpstan": "Static analysis (phpstan-drupal, deprecation rules, level 5).",
        "phpunit": "Unit, Kernel and Functional tests of both modules."
    }
}
