<?php

/**
 * @file
 * Requirements hook of the path purge module.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\perf_purge_paths\Hook\PerfPurgePathsHooks;

/**
 * Implements hook_requirements().
 *
 * Drupal 11.3 and later run the OOP runtime_requirements hook instead (see
 * \Drupal\perf_purge_paths\Hook\PerfPurgePathsHooks); this shim is the
 * Drupal 10.6 to 11.2 path.
 */
#[LegacyRequirementsHook]
function perf_purge_paths_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  return \Drupal::service(PerfPurgePathsHooks::class)->runtimeRequirements();
}
