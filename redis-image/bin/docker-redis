#!/bin/bash
set -e

# Test, build, tag and push the Redis (Valkey) cache image to ACR, as
#   acrcigie.azurecr.us/services/perf-redis:valkey-<version>-<revision>.
#   The image is deployed by its exact tag (Bicep redisImage), never 'latest'.

# Change to the repo root (one directory above this script)
cd "$(dirname "$0")/.." || exit

REVISION=$1
SCRIPT="image/push.sh"

if [ ! -f "$SCRIPT" ]; then
  echo "image/push.sh not found. Run bin/docker-redis from the redis-image repo."
  exit 1
fi

if [ -z "$REVISION" ]; then
  read -p "Enter the image revision (1 for a new Valkey version, then 2, 3, ...): " REVISION
fi

bash "$SCRIPT" "$REVISION"
