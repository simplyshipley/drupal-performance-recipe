#!/bin/bash
set -e

# Change to one directory above the script
cd "$(dirname "$0")/.." || exit

VERSION=$1

if [ -z "$VERSION" ]; then
  BASE=$(sed -n 's/^FROM valkey\/valkey:\([0-9.]*\)-.*/\1/p' image/Dockerfile)
  VERSION=$(git tag -l "$BASE-*" | sort -V | tail -n 1)
fi

CONTAINER="perf-redis-test-$VERSION"

if [ -n "$(docker ps -q -f "name=^$CONTAINER$")" ]; then
  echo "Container $CONTAINER is already running."
elif [ -n "$(docker ps -aq -f "name=^$CONTAINER$")" ]; then
  echo "Starting existing container: $CONTAINER..."
  docker start "$CONTAINER" > /dev/null
else
  # SYNTHETIC password, for this local test only.
  echo "Running new container: $CONTAINER..."
  docker run -d --name "$CONTAINER" -e REDIS_PASSWORD=synthetic-local-test "perf-redis:$VERSION" > /dev/null
fi

for _ in $(seq 1 15); do
  docker exec "$CONTAINER" redis-cli --user health --pass x --no-auth-warning ping > /dev/null 2>&1 && break
  sleep 1
done

echo "PING as the health user: $(docker exec "$CONTAINER" redis-cli --user health --pass x --no-auth-warning ping 2>&1)"
echo "PING as the app user:    $(docker exec "$CONTAINER" sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli ping' 2>&1)"
docker exec "$CONTAINER" sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli info memory' | tr -d '\r' | grep -E '^maxmemory_(human|policy):'
echo "Stop it with: bin/docker-test-stop $VERSION"
