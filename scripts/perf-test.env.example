# Settings for scripts/test-local.sh and scripts/perf-cache.sh.
# Copy to the site root as perf-test.env (in Lando: /app/perf-test.env).
# KEY=VALUE lines, no quotes; lines starting with # are ignored.
# A variable set on the command line or in the environment wins over this file.
# No secrets here.

# The site as the tests reach it from inside the app container.
BASE_URL=https://<project>.lndo.site
# Without HTTPS:
#BASE_URL=http://<project>.lndo.site
# Lando's internal web server (also the default when nothing is set):
#BASE_URL=http://appserver_nginx

# Page the read-only tests fetch: a page anonymous visitors can cache. Avoid
# pages with webforms or registration/password forms; Honeypot's time limit
# turns page caching off there.
PERF_TEST_PATH=/

# 1 = also run the edge (Front Door + WAF stand-in) tests; 0 = the site has no edge service.
PERF_EDGE=1
